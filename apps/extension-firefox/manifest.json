{
  "manifest_version": 2,
  "name": "BYEADS — Web Shield & Deception Engine",
  "version": "1.1.0",
  "description": "Free, open-source protection against intrusive ads, tracking, scams, and deceptive downloads by LoopHora.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defuser.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    "defuser.js"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BYEADS Protection"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "byeads@loophora.org",
      "strict_min_version": "91.0"
    }
  }
}
